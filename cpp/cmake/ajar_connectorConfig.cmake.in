@PACKAGE_INIT@

# Resolve the protobuf runtime the SDK links against, mirroring the main build's
# CONFIG-then-MODULE fallback (modern brew/Linux vs. older apt protobuf).
include(CMakeFindDependencyMacro)
find_dependency(protobuf CONFIG QUIET)
if(NOT protobuf_FOUND)
  find_dependency(Protobuf MODULE)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ajar_connectorTargets.cmake")

check_required_components(ajar_connector)
